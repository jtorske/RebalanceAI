# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# Environment files — never commit real secrets
client/.env
client/.env.local
client/.env.production
client/.env.development
server/.env

# Allow committed example/template files
!client/.env.example
!client/.env.production.example
!server/.env.example

# Python / FastAPI
__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# Python build artifacts
build/
dist/
*.egg-info/

# Server runtime / local data
server/.pytest_cache/
server/data/holdings_store.json
server/data/*.json

# Frontend (fallback at repo root)
node_modules/
client/node_modules/
client/dist/
client/dist-ssr/
client/.vite/
client/*.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
logs/
client/logs/

